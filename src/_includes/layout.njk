<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("GRSnews") }}</title>

  <!-- Google AdSense -->
  <script async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6593537699873785"
    crossorigin="anonymous"></script>

  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <h1><a href="/">GRSnews</a></h1>
      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/news">News</a>
        <a href="/science">Science</a>
        <a href="/geopolitics">Geopolitics</a>
        <a href="/sports">Sports</a>
        <a href="/store">Store</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </header>

  <main class="container">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <!-- Dynamic year via JavaScript -->
      <p>&copy; <script>document.write(new Date().getFullYear());</script> GRSnews. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
